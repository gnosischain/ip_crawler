# ClickHouse (clickhouse-connect speaks HTTP: 8123 plain, 8443 TLS)
CLICKHOUSE_HOST=your-clickhouse-host
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_DATABASE=crawlers_data
CLICKHOUSE_SECURE=true

# Tables
IP_INFO_TABLE=ipinfo
NEBULA_VISITS_TABLE=nebula.visits

# ipinfo.io
IPINFO_API_TOKEN=your-ipinfo-token
# Requests per day; the crawler spaces calls to stay inside it. 0 disables throttling.
IPINFO_RATE_LIMIT=50000
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_DELAY=5

# Discovery window for the nebula job
LOOKBACK_DAYS=2
WINDOW_CHUNK_HOURS=24
MAX_IPS_PER_RUN=10000
# Sweep phase of the nightly job: repairs [now-SWEEP_LOOKBACK_DAYS, now-LOOKBACK_DAYS) oldest-first
# under its own cap and time budget; 0 disables
SWEEP_LOOKBACK_DAYS=30
SWEEP_MAX_IPS_PER_RUN=500
SWEEP_MAX_SECONDS=3600
# Comma-separated beacon-chain fork digests that identify Gnosis peers (defaults built in)
# FORK_DIGESTS=0x56fdb5e0,0x824be431,0x21a6f836,0x3ebfd484,0x7d5aab40,0xf9ab5f85

# Run behaviour
# once | single-run = one window run; dry-run = print the work list only; anything else = continuous loop
CRAWLER_MODE=once
DRY_RUN=false
BATCH_SIZE=50
SLEEP_INTERVAL=3600

# Explicit IP sources (IP_SOURCE=hopr in a container, or --source hopr on the CLI)
HOPR_NODES_TABLE=dbt.int_hopr_nodes
